{
  "name": "loa-design-backend",
  "version": "1.0.0",
  "description": "Backend API — Loa Design Digital",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "test": "npm run test:static && npm run test:integration",
    "test:static": "node --test \"tests/static/**/*.test.js\"",
    "test:check": "node scripts/test-env-run.js check",
    "test:db:push": "node scripts/test-env-run.js push",
    "test:integration": "node scripts/test-env-run.js test",
    "db:guard": "node scripts/db-guard-check.js",
    "db:generate": "prisma generate",
    "db:validate": "node scripts/prisma-safe.js validate",
    "db:push": "node scripts/prisma-safe.js db push --skip-generate",
    "db:migrate": "node scripts/prisma-safe.js migrate dev",
    "db:migrate:prod": "node scripts/prisma-safe.js migrate deploy",
    "db:studio": "node scripts/prisma-safe.js studio",
    "db:reset": "node scripts/prisma-safe.js migrate reset --skip-seed",
    "db:bootstrap": "node prisma/bootstrap.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.10.0",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

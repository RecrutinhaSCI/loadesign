# ─────────────────────────────────────────────────────────────────────────────
# Loa Design Backend — ambiente de TESTES automatizados
# Copie para .env.test (ignorado pelo Git). Nunca aponte para produção.
#
# Banco separado do desenvolvimento: "loadesign_test", no mesmo PostgreSQL local.
# Os testes poderão apagar e recriar dados livremente neste banco.
#
# O banco é criado automaticamente na primeira subida do container
# (Backend/docker/postgres/init/01-create-test-db.sql).
# O executor de testes RECUSA rodar se o nome do banco não for exatamente
# "loadesign_test", se o host não for local ou se NODE_ENV não for "test".
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=test

# Mesmo container local do dev (Backend/docker-compose.yml), banco separado.
DATABASE_URL="postgresql://loa_local:loa_local_dev@localhost:55432/loadesign_test?schema=public"

# Guard: somente hosts locais. Não adicione hosts externos.
# DB_ALLOWED_HOSTS=

PORT=3334
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Segredo exclusivo de teste — não reutilize em nenhum outro ambiente.
JWT_SECRET=test_only_secret_nao_usar_fora_dos_testes_automatizados_0000
JWT_EXPIRES_IN=1h
